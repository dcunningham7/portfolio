---
const today = new Date();
---

<footer class="site-footer">
	<a class="footer-wordmark" href="/">Dylan James</a>

	<div class="credits">
		<p>&copy; {today.getFullYear()} Dylan James</p>

		<nav aria-label="Footer navigation">
			<a href="/projects">Projects</a>
			<a href="/work">Work</a>
			<a href="/about">About</a>
		</nav>

		<div class="social-links">
			<a href="https://linkedin.com/in/dylancdev" target="_blank" rel="noreferrer">LinkedIn ↗</a>
			<a href="https://github.com/ProgramDyl" target="_blank" rel="noreferrer">GitHub ↗</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding: clamp(2rem, 5vw, 5rem) clamp(1rem, 4vw, 4rem) 1.5rem;
		border-top: 3px solid #c8171d;
		background: #17130f;
		color: #f7e8c8;
	}

	.footer-wordmark {
		display: block;
		width: fit-content;
		margin-left: auto;
		margin-bottom: clamp(3rem, 8vw, 7rem);
		color: #f4b51b;
		font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
		font-size: clamp(4rem, 13vw, 11rem);
		line-height: 0.8;
		letter-spacing: -0.02em;
		text-align: right;
		text-decoration: none;
		text-transform: uppercase;
	}

	.credits {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: end;
		gap: clamp(1.5rem, 4vw, 4rem);
		padding-top: 1rem;
		border-top: 1px solid #f7e8c8;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.credits p {
		margin: 0;
	}

	nav,
	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
	}

	.site-footer a {
		color: #f7e8c8;
		text-decoration: none;
	}

	.site-footer a:hover {
		color: #f4b51b;
	}

	.footer-wordmark:hover {
		color: #c8171d;
	}

	@media (max-width: 720px) {
		.credits {
			grid-template-columns: 1fr;
			align-items: start;
		}
	}
</style>
