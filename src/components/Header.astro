---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const year = new Date().getFullYear();
---

<header class="site-header">
	<nav aria-label="Primary navigation">
		<a class="identity" href="/">
			<span class="index-mark">DJ / {year}</span>
			<span class="site-title">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/work">Work</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		margin: 0;
		padding: 0 clamp(1rem, 3vw, 2.5rem);
		border-bottom: 2px solid #c8171d;
		background: #17130f;
		color: #f7e8c8;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 3.75rem;
		gap: 2rem;
	}

	.identity {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: #f7e8c8;
		text-decoration: none;
	}

	.index-mark {
		padding: 0.2rem 0.4rem;
		background: #f4b51b;
		color: #17130f;
		font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		line-height: 1;
	}

	.site-title {
		font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
		font-size: 1.15rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.internal-links {
		display: flex;
		align-items: stretch;
		gap: clamp(0.75rem, 2vw, 2rem);
		align-self: stretch;
	}

	.internal-links :global(a) {
		display: flex;
		align-items: center;
		padding: 0.25rem 0;
		border-bottom: 3px solid transparent;
		color: #f7e8c8;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		border-bottom-color: #c8171d;
		color: #f4b51b;
		text-decoration: none;
	}

	@media (max-width: 720px) {
		.site-header {
			padding-inline: 1rem;
		}

		.site-title {
			display: none;
		}

		.internal-links {
			gap: 0.8rem;
		}

		.internal-links :global(a) {
			font-size: 0.62rem;
		}
	}
</style>
