---
// src/components/CrtMonitor.astro
interface Props {
  className?: string;
}
const { className = "" } = Astro.props;
---

<div class={`crt-container ${className}`}>
  <div class="monitor-shell">
    <img src="/crt-bezel.svg" alt="Dell 1997 CRT Monitor Chassis" class="bezel-graphics" />
    
    <div class="screen-viewport">
      <div class="screen-curvature-layer">
        <div class="scanlines-overlay"></div>
        <div class="glass-vignette"></div>
        
        <div class="live-content-wrapper"> 
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Wrapper positioning context */
  .crt-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 1100px; 
    margin: 0 auto;
    padding: 20px;
    box-sizing: border-box;
  }

  .monitor-shell {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3; 
  }

  .bezel-graphics {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    display: block;
    z-index: 10;
    position: relative;
  }

  .screen-viewport {
    position: absolute;
    top: 8.5%;
    left: 8.5%;
    width: 83%;
    height: 77%;
    background: #1e1e1e;
    overflow: hidden;
    z-index: 5;
  }

  .screen-curvature-layer {
    width: 100%;
    height: 100%;
    position: relative;
    transform: perspective(1000px) scaleX(1.01) scaleY(1.03);
    border-radius: 4.5% / 4.5%; 
    overflow: hidden;
  }

  .glass-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    background: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.05) 0%,
      rgba(0, 0, 0, 0.2) 65%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .scanlines-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    background-image: url('https://githubusercontent.com');
    background-repeat: repeat;
    background-size: 4px 4px;
    opacity: 0.06; 
    mix-blend-mode: multiply;
  }

  /* actual content */
  .live-content-wrapper {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    padding: 30px;
    box-sizing: border-box;
    color: #a3e635; /* Retro green neon font default */
    font-family: monospace;
    
    /* Scrollbar cleanup for absolute seamless look inside the tube */
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.2) transparent;
  }
</style>
