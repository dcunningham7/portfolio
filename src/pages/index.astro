---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroImage from '../assets/Dyl-inForest-sun.jpg';



const faqItems = [
  {
    question: "Are you open to full-time roles?",
    answer: "Yes. I'm currently looking for a full-time software developer role. I'm based in Montreal and seeking an on-site role, however I'm also open to remote or hybrid arrangements. I'm currently working remotely as a full-stack developer on a production SaaS product, so I'm looking for a thoughtful transition. The best way to reach me is via LinkedIn or email."
  },
  {
    question: "What kind of role are you looking for?",
    answer: "I want a team-based full-stack role where I can contribute wherever I’m most useful: UI, APIs, data modeling, ops, infra, design, whatever moves the product forward. I’ve shipped across the stack and I’m looking to grow through real team experience, not by narrowing into one lane too early."
  },
    {
    question: "What is your development stack?",
    answer: "It depends on the scope of the project! This portfolio site was built with Astro, which is heavy on html/css. For frontend development, I have professional experience with frameworks like Blazor, React, Vite, and Next.js. For backend development I have used .NET and Node.js with PostgreSQL or MySQL. I also have experience with deployment pipelines using Docker and Azure."
  },
  {
    question: "How do you work on a team?",
    answer: "Yes! I'm at my best on collaborative teams where people talk, review each other's work, and share context."
  },
  {
    question: "How do you approach a new project?",
    answer: "I always start with research. Depending on the degree of difficulty, I will break the research phase into chunks to better determine which direction the project should go in. Rough drafts, design documents, and as much feedback/discussion with stakeholders as possible."
  }

];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
    <hero-section> 
      <hero-content> 
          <hero-cta-column>  
            <hero-cta-section>    
              <hero-label>Musician turned software developer passionate about creating immersive experiences.</hero-label>
              <hero-cta-title> 
                <h1>Dylan</h1>
                <h1>James</h1>
              </hero-cta-title>
              
              <hero-nav-section> 
                <a href="/projects">Projects</a>
                <a href="/work">Work</a>
                
                <a href="/about">About Me</a>
                
              </hero-nav-section>
            </hero-cta-section>
          </hero-cta-column>  

          <hero-img-column>
            <hero-img> 
              <Image height={1280} width={1000} src={heroImage} alt="" />
            </hero-img>
          </hero-img-column>


      </hero-content>

      <!-- <div class="hero-logo-mark" aria-hidden="true">logo</div> -->
    </hero-section>

    <FAQ items={faqItems} />

	</body>
</html>


<style>
  hero-section {
    position: relative;
    width: 100%;
    min-height: 250vh; 
    background: #F8B71D;  
    padding-bottom: var(--space-2xl);
    display: flex;
    align-items: flex-start; 
  }

  hero-section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(circle at 40% 50%, transparent 60%, rgba(0,0,0,0.4) 100%); 
  }

  hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 250vh;           
    align-items: start;
  }

  hero-cta-column {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1rem, 3vmin, 4rem) clamp(1rem, 2vmin, 3rem);
    margin: 0 auto;
    min-height: 100vh; 
  }

  hero-cta-section {
    margin-bottom: 25vh;
  }

  hero-label {
    display: block;
    font-family: 'ITC Bookman', sans-serif;
    font-size: clamp(0.6rem, 0.9vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #000;
    margin-bottom: var(--space-md);
    width: fit-content;
    animation: fadeInLeft 0.8s ease-out;
    padding-left: 60%;
    text-shadow: -1px -1px 1px rgba(0,0,0,0.15);
  }

  hero-cta-title {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    margin-bottom: clamp(1rem, 4vh, 3rem);
    margin-top: clamp(2rem, 4vh, 3rem);
  }

  hero-cta-title h1 {
    font-size: clamp(10rem, 20rem, 37rem);
    line-height: 1;
    margin: 0; 
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    letter-spacing: -0.02em;
  }

  hero-cta-title h1:first-child {
    color: #D61A1F;
    text-shadow: -1px -1px 1px rgba(0,0,0,0.15), 1px 1px 1px rgba(0,0,0,0.4);
  }

  hero-img-column {
    position: sticky; 
    top: 0;          
    right: 0;
    width: 100%;
    height: 100vh;   
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: start;
  }

  hero-img {
    display: block;
    width: 100%;       
    height: 100%;      
  }

  hero-img :global(img),
  hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover; 
    display: block;
  }

  hero-nav-section {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: clamp(0.75rem, 1.5vw, 2rem);
    margin-top: clamp(8rem, 5vh, 13rem);
    border-top: 3px solid #000;
    padding-top: 0.8rem;
  }

  hero-nav-section a {
    font-family: 'ITC Bookman', sans-serif;
    font-size: clamp(1rem, 1.3vw, 1.3rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #000;
    padding: 0.3rem 0;
    border-bottom: 3px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    text-shadow: -1px -1px 1px rgba(0,0,0,0.15), 1px 1px 1px rgba(0,0,0,0.4);
  }

  hero-nav-section a:hover {
    content: '●';
    color: #D61A1F;
    margin-left: 0.5rem;
  }

