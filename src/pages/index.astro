---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import CrtMonitor from '../components/CrtMonitor.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		

    <page-wrapper> 
      <hero-section>
        <h1>Dylan</h1>
        <h1>James</h1>
      </hero-section>
      
    </page-wrapper>
		
		<Footer />
	</body>
</html>


<style>
  .page-wrapper {
    background: #0f1115;
    min-height: 100vh;
    min-width: 100vw;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-section {
    background: #F8B71D;
    
  }
  .retro-nav {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
    border-bottom: 1px solid #a3e635;
    padding-bottom: 10px;
  }
  .retro-nav a {
    color: #a3e635;
    text-decoration: none;
  }
  .retro-nav a:hover {
    background: #a3e635;
    color: #000;
  }
</style>