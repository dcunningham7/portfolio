---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroImage from '../assets/Dyl-inForest-sun.jpg';



const faqItems = [
  {
    question: "What inspires you?",
    answer: "I am always inspired by work created by hand. Old advertisements, album covers, film, and tv that require real observation. Work was done painstakingly by hand back then and I really admire that level of detail. I draw direct inspiration of the aesthetic choices of film directors like Stanley Kubrick, Brian De Palma, Akira Kurosawa, and Spike Lee. Also a big fan of the iconic Blue Note album covers done by Francis Wolff & Reid Miles. "
  },
    {
    question: "What is your development stack?",
    answer: "It depends on the scope of the project! This portfolio site was built with Astro, which is heavy on html/css. For frontend development, I have professional experience with frameworks like Blazor, React, Vite, and Next.js. For backend development I have used .NET and Node.js with PostgreSQL or MySQL. I also have experience with deployment pipelines using Docker and Azure."
  },
  {
    question: "Do you take on freelance projects?",
    answer: "Yes! I’m available for select collaborations. Feel free to reach out via the contact form or email, I will get back to you as soon as I can."
  },
  {
    question: "How do you approach a new project?",
    answer: "I always start with research. Depending on the degree of difficulty, I will break the research phase into chunks to better determine which direction the project should go in. Rough drafts, design documents, and as much feedback/discussion with stakeholders as possible."
  }

];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
    <hero-section> 
      <hero-content> 
          <hero-cta-column>  
            <hero-cta-section>    
              <hero-label>Musician turned software developer passionate about creating immersive experiences.</hero-label>
              <hero-cta-title> 
                <h1>Dylan</h1>
                <h1>James</h1>
              </hero-cta-title>
              
              <hero-nav-section> 
                <a href="/blog">Projects</a>
                <a href="/about">About Me</a>
                <a href="/work">Work</a>
              </hero-nav-section>
            </hero-cta-section>
          </hero-cta-column>  

          <hero-img-column>
            <hero-img> 
              <Image height={1280} width={1000} src={heroImage} alt="" />
            </hero-img>
          </hero-img-column>


      </hero-content>
    </hero-section>

    <FAQ items={faqItems} />

	</body>
</html>


<style>
  hero-section {
    position: relative;
    width: 100%;
    min-height: 110vh; 
    background: #F8B71D;  
    padding-bottom: var(--space-2xl);
    display: flex;
    align-items: flex-start; /
  }

  hero-section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(circle at 40% 50%, transparent 60%, rgba(0,0,0,0.4) 100%); 
  }

  hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100%;           
    align-items: stretch; 
  }

  hero-cta-column {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1rem, 3vmin, 4rem) clamp(1rem, 2vmin, 3rem);
    margin: 0 auto;
    min-height: 100vh; 
  }

  hero-cta-section {
    margin-bottom: 25vh;
  }

  hero-label {
    display: block;
    font-family: 'Courier New', monospace;
    font-size: clamp(0.7rem, 1vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #000;
    margin-bottom: var(--space-md);
    width: fit-content;
    animation: fadeInLeft 0.8s ease-out;
    padding-left: 60%;
  }

  hero-cta-title {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    margin-bottom: clamp(1rem, 4vh, 3rem);
    margin-top: clamp(2rem, 4vh, 3rem);
  }

  hero-cta-title h1 {
    font-size: clamp(8rem, 15rem, 30.5rem);
    line-height: 1;
    margin: 0; 
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    letter-spacing: -0.02em;
  }

  hero-cta-title h1:first-child {
    color: #D61A1F;
    text-shadow: -1px -1px 1px rgba(0,0,0,0.15), 1px 1px 1px rgba(0,0,0,0.4);
  }

  hero-img-column {
    position: sticky; 
    top: 0;          
    right: 0;
    width: 100%;
    height: 100vh;   
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  hero-img {
    display: block;
    width: 100%;       
    height: 100%;      
  }

  hero-img :global(img),
  hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover; 
    display: block;
  }

  hero-nav-section {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: clamp(0.75rem, 1.5vw, 2rem);
    margin-top: clamp(8rem, 5vh, 13rem);
    border-top: 3px solid #000;
    padding-top: 0.8rem;
  }

  hero-nav-section a {
    font-family: 'Courier New', monospace;
    font-size: clamp(0.9rem, 1.2vw, 1.2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #000;
    padding: 0.3rem 0;
    border-bottom: 3px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
  }

  hero-nav-section a::after {
    content: '●';
    color: #D61A1F;
    margin-left: 0.5rem;
    font-size: 0.6rem;
  }

  hero-nav-section a:hover {
    font-size: clamp(1.1rem, 1.5vw, 1.5rem);
  }
</style>



