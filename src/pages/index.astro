---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroImage from '../assets/Dyl-inForest-sun.jpg';
import djLogo from '../assets/dj_logo.png'
import FloatingContact from '../components/FloatingContactBtn.astro';



const faqItems = [
  { 
    question: "Are you open to full-time roles?", 
    answer: "Yes. I'm looking for a full-time software development role and I'm open to frontend, backend, or full-stack work. I'm also open to hybrid or on-site teams, while being very comfortable working remotely. At this point in my career, I'm looking for a place where I can keep learning, work with good people, and build things that are worth building." 
  },
  { 
    question: "What kind of role are you looking for?", 
    answer: "I'm less interested in a particular job title than I am in the problems I'll get to work on. I've worked across frontend, backend, databases, cloud infrastructure, and CI/CD, and I'd be happy to go deeper in any of those areas. I want to join a team where I can contribute from day one, learn from experienced developers, and gradually take on bigger problems." 
  },
  { 
    question: "How do you work on a team?", 
    answer: "I like working with people who care about doing good work and aren't afraid to question an idea. I'm a fan of code reviews, design discussions, clear documentation, and asking for a second opinion before a small problem becomes a large one. I also try to be the kind of teammate I'd want to have: communicative, curious, dependable, and willing to admit when I don't know something." 
  }, 
  { 
    question: "How do you approach a new project?", 
    answer: "I start by trying to understand the problem, not the technology. I'll research the domain, break the work into smaller pieces, sketch ideas, think through the architecture and API contracts, and get feedback early. Then I like to build something, see where my assumptions were wrong, and adjust." 
  },
  { 
    question: "Can you work independently?", 
    answer: "Absolutely. I've taken features from a rough idea through architecture, implementation, testing, and deployment, so I'm comfortable owning a problem from start to finish. It's important to note that I am not afraid to ask questions when I get stuck, rather than suffer a knowledge gap silently." 
  },
];

---

<!doctype html>
<html lang="en">

	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
    <hero-section> 
      <hero-content> 
 
        <hero-img-column>
          <hero-img> 
            <Image height={1280} width={1000} src={heroImage} alt="Portrait of Dylan James standing in a forest." />
          </hero-img>
        </hero-img-column>

        <hero-cta-column>  
          <hero-cta-section>    
            
            <hero-label>Software Developer. Montreal/Toronto.</hero-label>
            <hero-cta-title> 
              <h1>Dylan</h1>
              <h1>James</h1>
            </hero-cta-title>
            
            <hero-nav-section> 
              <a href="/projects">01 Projects</a>
              <a href="/work">02 Work</a>
              
              <a href="/about">03 About Me</a>
              
            </hero-nav-section>
          </hero-cta-section>
        </hero-cta-column> 

      </hero-content>
    <!-- <div class="hero-logo-mark" aria-hidden="true">logo</div> -->
    </hero-section>
    <FAQ items={faqItems} />
    <FloatingContact />
	</body>
</html>

<style>

  hero-section {
    position: relative;
    width: 100%;
    min-height: 100svh;
    max-width; 100vw;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #d99a16, #f8b71d);  
    padding-bottom: var(--space-2xl);
  }

  hero-section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;

  }

  hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    min-height: 100svh;     
    align-items: start;
  }

  hero-cta-column {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: clamp(1rem, 3vmin, 4rem) clamp(1rem, 2vmin, 3rem);
    margin: 0 auto;
    min-height: 100svh; 
  }

  hero-cta-section {
    display: flex;
    flex-direction: column;
    height: 85vh;
    justify-content: space-between;
  }

  hero-label {
    display: block;
    font-family: "Archivo", sans-serif;
    font-size: .7rem;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #17130f;
    margin-bottom: var(--space-md);
    width: fit-content;
    animation: fadeInLeft 0.8s ease-out;
    align-self: flex-end;
    max-width: 50ch;
    text-align: left;
  }



  hero-cta-title {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    margin-bottom: clamp(1rem, 2vh, 1rem);
    margin-top: clamp(2rem, 4vh, 3rem);
  }

  hero-cta-title h1 {
    font-size: clamp(10rem, 16vw, 18rem);
    line-height: .87;
    letter-spacing: -.02em;
    margin: 0;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    text-shadow: 2px 3px 0 rgba(0,0,0,.12), -1px -1px 0 rgba(255,255,255,.15);
  }


  hero-cta-title h1:first-child {
    color:#c91d1d;
    text-shadow: 1px 1px 0 rgba(0,0,0,.18), 0 0 1px rgba(0,0,0,.3);
  }

  hero-img-column {
    position: sticky; 
    top: 0;          
    right: 0;
    width: 90%;
    height: 100vh;   
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: start;
  }

  hero-img::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    z-index: 2;
    transform: translateX(0);

    animation: sideSwipeReveal 1s cubic-bezier(.77, 0, .18, 1) forwards;
  }

  @keyframes sideSwipeReveal {

    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-100%);
    }
  }

  hero-img {
    display: block;
    width: 100%;       
    height: 100%;      
    filter:
      sepia(.12)
      contrast(1.05)
      saturate(.9);
  }

  hero-img :global(img),
  hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover; 
    display: block;
  }

  hero-nav-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-top: clamp(6rem, 4vh, 11rem);
    border-top: 3px solid #000;
    padding-top: 0.8rem;
    width:100%;
  }

  hero-nav-section a {
    font-family: 'ITC Bookman', sans-serif;
    font-size: .85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .25em;
    color: #000;
    padding: 0.3rem 0;
    border-bottom: 3px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    text-shadow: -1px -1px 1px rgba(0,0,0,0.15), 1px 1px 1px rgba(0,0,0,0.4);
  }

  hero-nav-section a:hover {
    color: #D61A1F;
  }

  .hero-logo-mark {
    position: absolute;
    left: 25%;
    top: 62%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: min(42vw, 22rem);
    height: min(42vw, 22rem);
    border-radius: 50%;
    background: #17130f;
    color: #f7e8c8;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    font-size: clamp(1.25rem, 3vw, 2rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  @media (max-width:1200px){

    hero-content {
      grid-template-columns:1fr .85fr;
    }

    hero-cta-title h1 {
      font-size:clamp(7rem,15vw,11rem);
    }

    hero-label {
      max-width:22rem;
    }

    hero-nav-section {
      justify-content: space-between;
    }
  }


  @media (max-width:850px){
    hero-section {
      display:block;
      min-height: 90svh;
      overflow:hidden;
    }

    hero-content {
      display:block;
    }

    hero-cta-column {
      min-height: 10svh;
      padding: 2rem 1.5rem;
      align-items: flex-start;
      text-align: center;
    }

    hero-cta-section {
      width: 100%;
      height: 42svh;
      justify-content: flex-start;
    }

    hero-label {
      font-size: .5em;
      font-weight: 700;
      letter-spacing: 0em;
      text-shadow: none;
      width: 65%;
    }

    hero-cta-title h1 {
      font-size: clamp(11rem, 27vw, 12rem);
      line-height:.82;
    }

    hero-nav-section a {
      font-size: 0.5em;
      font-weight: 800;
    }
    
    
    hero-img-column {
      position: relative;
      width: 100%;
      height: 50svh;
      overflow: hidden;
      margin-top: 0rem;
    }

    hero-img {
      display: block;
      width: 100%;
      height: 100%;
    }

    hero-img :global(img),
    hero-img img {
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center center;
      display:block;
    }
  }

  @media (max-width: 800px) {
  hero-section,
  hero-content {
    min-height: auto;
  }

  hero-content {
    grid-template-columns: 1fr;
  }

  hero-cta-column {
    min-height: auto;
    padding: 1.5rem 1rem 0;
  }

  hero-cta-section {
    margin-bottom: 0rem;
  }

  hero-label {
    padding-left: 0;
    margin-left: auto;
    max-width: 70%;
    font-size: 0.65rem;
  }

  hero-cta-title {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  hero-cta-title h1 {
    font-size: clamp(4.5rem, 28vw, 8rem);
  }

  hero-nav-section {
    margin-top: 1.5rem;
  }

  hero-img-column {
    position: relative;
    height: 55vh;
    min-height: 280px;
  }
}

  @media (max-width: 375px) {
    hero-section {
      min-height: auto;
      overflow: visible;
    }

    hero-cta-column {
      padding: 1rem 0.85rem 0.75rem;
    }

    hero-cta-section {
      height: auto;
      justify-content: flex-start;
      gap: 1.5rem;
    }

    hero-label {
      width: 100%;
      max-width: none;
      margin-left: 0;
      font-size: 0.58rem;
      letter-spacing: 0.06em;
      line-height: 1.45;
    }

    hero-cta-title {
      margin-top: 0;
      margin-bottom: 0;
    }

    hero-cta-title h1 {
      font-size: clamp(7rem, 28vw, 7rem);
      line-height: 0.85;
      white-space: nowrap;
    }

    hero-nav-section {
      gap: 0.4rem;
      margin-top: 0.6rem;
    }

    hero-nav-section a {
      font-size: 0.58rem;
      letter-spacing: 0.08em;
    }

    hero-img-column {
      height: 48svh;
      min-height: 120px;
    }

    faq-wrapper {
      margin-top: 0rem;
      padding: 3rem 1.5rem;
    }

    
  }
</style>



