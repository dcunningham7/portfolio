---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroImage from '../assets/Dyl-inForest-sun.jpg';
import djLogo from '../assets/dj_logo.png'
import FloatingContact from '../components/FloatingContactBtn.astro';



const faqItems = [
  {
    question: "Are you open to full-time roles?",
    answer: "Yes, I am looking for a full-time role. I am open to hybrid or on-site setups, but I am highly effective in remote teams. I currently manage a production SaaS product entirely remotely, so I already have a great rhythm down for asynchronous communication and keeping my team in the loop."
  },
  {
    question: "What kind of role are you looking for?",
    answer: "I am targeting a frontend role where my backend experience can be a sn asset. I love building clean UIs and reusable components. Because I understand APIs, database architecture, and deployment pipelines, I can easily collaborate with the infrastructure team and bridge the gap between both worlds."
  },
  {
    question: "What is your development stack?",
    answer: "It depends on the project. This portfolio is built with Astro for speed, but for daily frontend work, my go-to tools are React, Next.js, Vite, and TypeScript. On the backend, I work comfortably with .NET, Node.js, and relational databases. I also handle my own ops using Docker and Azure pipelines."
  },
  {
    question: "How does your specialized database experience fit into frontend?",
    answer: "I've worked extensively with advanced PostgreSQL features like pgvector for semantic search and PostGIS for geocoding. While that is backend-heavy, it gives me a massive advantage when designing complex UIs. I know exactly how to structure frontend states to interact cleanly with specialized APIs and maps."
  },
  {
    question: "How do you work on a team?",
    answer: "I do my best work on collaborative teams that prioritize thorough code reviews, open design discussions, and clear documentation. I enjoy contributing to shared design systems and making sure the code I ship is clean, readable, and easy for the next developer to pick up."
  },
  {
    question: "How do you approach a new project?",
    answer: "I start with research and break complex goals into bite-sized chunks. Before writing code, I like to map out technical design docs, sketch rough UI wireframes, and establish API contracts with the team. Getting feedback early saves a ton of rewrite time later on."
  },
  {
    question: "Can you work independently?",
    answer: "Definitely. I am completely comfortable taking a feature from a loose idea all the way to production on my own—from the architecture and UI down to testing and deployment. That said, I am not a lone wolf; I know exactly when a feature needs a quick team sanity check."
  }
];

---

<!doctype html>
<html lang="en">

	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
    <hero-section> 
      <hero-content> 
 
        <hero-img-column>
          <hero-img> 
            <Image height={1280} width={1000} src={heroImage} alt="Portrait of Dylan James standing in a forest." />
          </hero-img>
        </hero-img-column>

        <hero-cta-column>  
          <hero-cta-section>    

            <hero-label>Musician turned software developer passionate about creating immersive experiences.</hero-label>
            <hero-cta-title> 
              <h1>Dylan</h1>
              <h1>James</h1>
            </hero-cta-title>
            
            <hero-nav-section> 
              <a href="/projects">01 Projects</a>
              <a href="/work">02 Work</a>
              
              <a href="/about">03 About Me</a>
              
            </hero-nav-section>
          </hero-cta-section>
        </hero-cta-column> 

      </hero-content>
    <!-- <div class="hero-logo-mark" aria-hidden="true">logo</div> -->
    </hero-section>
    <FAQ items={faqItems} />
    <FloatingContact />
	</body>
</html>

<style>

  hero-section {
    position: relative;
    width: 100%;
    min-height: 100svh;
    max-width; 100vw;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #d99a16, #f8b71d);  
    padding-bottom: var(--space-2xl);
  }

  hero-section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;

  }

  hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    min-height: 100svh;     
    align-items: start;
  }

  hero-cta-column {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: clamp(1rem, 3vmin, 4rem) clamp(1rem, 2vmin, 3rem);
    margin: 0 auto;
    min-height: 100svh; 
  }

  hero-cta-section {
    display: flex;
    flex-direction: column;
    height: 85vh;
    justify-content: space-between;
  }

  hero-label {
    display: block;
    font-family: "Archivo", sans-serif;
    font-size: .7rem;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #17130f;
    margin-bottom: var(--space-md);
    width: fit-content;
    animation: fadeInLeft 0.8s ease-out;
    align-self: flex-end;
    max-width: 50ch;
    text-align: left;
  }



  hero-cta-title {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    margin-bottom: clamp(1rem, 2vh, 1rem);
    margin-top: clamp(2rem, 4vh, 3rem);
  }

  hero-cta-title h1 {
    font-size: clamp(10rem, 16vw, 18rem);
    line-height: .87;
    letter-spacing: -.02em;
    margin: 0;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    text-shadow: 2px 3px 0 rgba(0,0,0,.12), -1px -1px 0 rgba(255,255,255,.15);
  }


  hero-cta-title h1:first-child {
    color:#c91d1d;
    text-shadow: 1px 1px 0 rgba(0,0,0,.18), 0 0 1px rgba(0,0,0,.3);
  }

  hero-img-column {
    position: sticky; 
    top: 0;          
    right: 0;
    width: 90%;
    height: 100vh;   
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: start;
  }

  hero-img::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    z-index: 2;
    transform: translateX(0);

    animation: sideSwipeReveal 1s cubic-bezier(.77, 0, .18, 1) forwards;
  }

  @keyframes sideSwipeReveal {

    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-100%);
    }
  }

  hero-img {
    display: block;
    width: 100%;       
    height: 100%;      
    filter:
      sepia(.12)
      contrast(1.05)
      saturate(.9);
  }

  hero-img :global(img),
  hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover; 
    display: block;
  }

  hero-nav-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-top: clamp(6rem, 4vh, 11rem);
    border-top: 3px solid #000;
    padding-top: 0.8rem;
    width:100%;
  }

  hero-nav-section a {
    font-family: 'ITC Bookman', sans-serif;
    font-size: .85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .25em;
    color: #000;
    padding: 0.3rem 0;
    border-bottom: 3px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    text-shadow: -1px -1px 1px rgba(0,0,0,0.15), 1px 1px 1px rgba(0,0,0,0.4);
  }

  hero-nav-section a:hover {
    color: #D61A1F;
  }

  .hero-logo-mark {
    position: absolute;
    left: 25%;
    top: 62%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: min(42vw, 22rem);
    height: min(42vw, 22rem);
    border-radius: 50%;
    background: #17130f;
    color: #f7e8c8;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    font-size: clamp(1.25rem, 3vw, 2rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  @media (max-width:1200px){

    hero-content {
      grid-template-columns:1fr .85fr;
    }

    hero-cta-title h1 {
      font-size:clamp(7rem,15vw,11rem);
    }

    hero-label {
      max-width:22rem;
    }

    hero-nav-section {
      justify-content: space-between;
    }
  }


  @media (max-width:850px){
    hero-section {
      display:block;
      min-height: 90svh;
      overflow:hidden;
    }

    hero-content {
      display:block;
    }

    hero-cta-column {
      min-height: 10svh;
      padding: 2rem 1.5rem;
      align-items: flex-start;
      text-align: center;
    }

    hero-cta-section {
      width: 100%;
      height: 42svh;
      justify-content: flex-start;
    }

    hero-label {
      font-size: .5em;
      font-weight: 700;
      letter-spacing: 0em;
      text-shadow: none;
      width: 65%;
    }

    hero-cta-title h1 {
      font-size: clamp(11rem, 27vw, 12rem);
      line-height:.82;
    }

    hero-nav-section a {
      font-size: 0.5em;
      font-weight: 800;
    }
    
    
    hero-img-column {
      position: relative;
      width: 100%;
      height: 50svh;
      overflow: hidden;
      margin-top: 0rem;
    }

    hero-img {
      display: block;
      width: 100%;
      height: 100%;
    }

    hero-img :global(img),
    hero-img img {
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center center;
      display:block;
    }
  }

  @media (max-width: 800px) {
  hero-section,
  hero-content {
    min-height: auto;
  }

  hero-content {
    grid-template-columns: 1fr;
  }

  hero-cta-column {
    min-height: auto;
    padding: 1.5rem 1rem 0;
  }

  hero-cta-section {
    margin-bottom: 0rem;
  }

  hero-label {
    padding-left: 0;
    margin-left: auto;
    max-width: 70%;
    font-size: 0.65rem;
  }

  hero-cta-title {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  hero-cta-title h1 {
    font-size: clamp(4.5rem, 28vw, 8rem);
  }

  hero-nav-section {
    margin-top: 1.5rem;
  }

  hero-img-column {
    position: relative;
    height: 55vh;
    min-height: 280px;
  }
}
</style>



