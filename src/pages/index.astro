---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroImage from '../assets/Dyl-inForest-sun.jpg';



const faqItems = [
  {
    question: "Are you open to full-time roles?",
    answer: "Yes. I'm currently looking for a full time on-site software developer role, however I'm also open to remote or hybrid arrangements. I'm currently working remotely as a full-stack developer on a production SaaS product, so I'm looking for a thoughtful transition. The best way to reach me is via LinkedIn or email."
  },
  {
    question: "What kind of role are you looking for?",
    answer: "I want a team-based full-stack role where I can contribute wherever I’m most useful: UI, APIs, data modeling, ops, infra, design, whatever moves the product forward. I’ve shipped across the stack and I’m looking to grow through real team experience, not by narrowing into one lane too early."
  },
    {
    question: "What is your development stack?",
    answer: "It depends on the scope of the project! This portfolio site was built with Astro, which is heavy on html/css. For frontend development, I have professional experience with frameworks like Blazor, React, Vite, and Next.js. For backend development I have used .NET and Node.js with PostgreSQL or MySQL. I also have experience with deployment pipelines using Docker and Azure."
  },
  {
    question: "How do you work on a team?",
    answer: "Yes! I'm at my best on collaborative teams where people talk, review each other's work, and share context."
  },
  {
    question: "How do you approach a new project?",
    answer: "I always start with research. Depending on the degree of difficulty, I will break the research phase into chunks to better determine which direction the project should go in. Rough drafts, design documents, and as much feedback/discussion with stakeholders as possible."
  },
  {
    question: "",
    answer: ""
  },
];
---

<!doctype html>
<html lang="en">

	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
    <hero-section> 
      <hero-content> 
        <hero-cta-column>  
          <hero-cta-section>    
            <hero-label>Musician turned software developer passionate about creating immersive experiences.</hero-label>
            <hero-cta-title> 
              <h1>Dylan</h1>
              <h1>James</h1>
            </hero-cta-title>
            
            <hero-nav-section> 
              <a href="/projects">01 Projects</a>
              <a href="/work">02 Work</a>
              
              <a href="/about">03 About Me</a>
              
            </hero-nav-section>
          </hero-cta-section>
        </hero-cta-column>  

        <hero-img-column>
          <hero-img> 
            <Image height={1280} width={1000} src={heroImage} alt="Portrait of Dylan James standing in a forest." />
          </hero-img>
        </hero-img-column>
      </hero-content>
    <!-- <div class="hero-logo-mark" aria-hidden="true">logo</div> -->
    </hero-section>
    <FAQ items={faqItems} />
	</body>
</html>

<style>

  hero-section {
    position: relative;
    width: 100%;
    min-height: 100svh;
    max-width; 100vw;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #d99a16, #f8b71d);  
    padding-bottom: var(--space-2xl);
  }

  hero-section::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;

  }

  hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    min-height: 100svh;     
    align-items: start;
  }

  hero-cta-column {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: clamp(1rem, 3vmin, 4rem) clamp(1rem, 2vmin, 3rem);
    margin: 0 auto;
    min-height: 100svh; 
  }

  hero-cta-section {
    display: flex;
    flex-direction: column;
    height: 85vh;
    justify-content: space-between;
  }

  hero-label {
    display: block;
    font-family: "Archivo", sans-serif;
    font-size: .7rem;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #17130f;
    margin-bottom: var(--space-md);
    width: fit-content;
    animation: fadeInLeft 0.8s ease-out;
    align-self: flex-end;
    max-width: 50ch;
    text-align: left;
    text-shadow: 0 1px 0 rgba(255,255,255,.35), 0 -1px 0 rgba(0,0,0,.25);
  }



  hero-cta-title {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    margin-bottom: clamp(1rem, 2vh, 1rem);
    margin-top: clamp(2rem, 4vh, 3rem);
  }

  hero-cta-title h1 {
    font-size: clamp(10rem, 16vw, 18rem);
    line-height: .87;
    letter-spacing: -.02em;
    margin: 0; 
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    text-shadow: 2px 3px 0 rgba(0,0,0,.12), -1px -1px 0 rgba(255,255,255,.15);

    animation: titleReveal 1s cubic-bezier(.2,.8,.2,1);
  }

  @keyframes titleReveal {

    from {
      opacity:0;
      transform:
        translateY(-30px);
      filter:blur(7px);
    }

    to {
      opacity:1;
      transform:
        translateY(0);
      filter:blur(0);
    }

  }

  hero-cta-title h1:first-child {
    color:#c91d1d;
    text-shadow: 1px 1px 0 rgba(0,0,0,.18), 0 0 1px rgba(0,0,0,.3);
  }

  hero-img-column {
    position: sticky; 
    top: 0;          
    right: 0;
    width: 100%;
    height: 100vh;   
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: start;
  }

  hero-img::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    z-index: 2;
    transform: translateX(0);

    animation: sideSwipeReveal 0.75s cubic-bezier(.77, 0, .18, 1) forwards;
  }

  @keyframes sideSwipeReveal {

    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(100%);
    }
  }

  hero-img {
    display: block;
    width: 100%;       
    height: 100%;      
    filter:
      sepia(.12)
      contrast(1.05)
      saturate(.9);
  }

  hero-img :global(img),
  hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover; 
    display: block;
  }

  hero-nav-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-top: clamp(6rem, 4vh, 11rem);
    border-top: 3px solid #000;
    padding-top: 0.8rem;
    width:100%;
  }

  hero-nav-section a {
    font-family: 'ITC Bookman', sans-serif;
    font-size: .85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .25em;
    color: #000;
    padding: 0.3rem 0;
    border-bottom: 3px solid transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    text-shadow: -1px -1px 1px rgba(0,0,0,0.15), 1px 1px 1px rgba(0,0,0,0.4);
  }

  hero-nav-section a:hover::after {
    color: #D61A1F;
    font-size: .55rem;
    opacity: 0;
    transform: translateX(-10px);
    transition:
      text-shadow .25s ease,
      transform .25s ease;
  }

  hero-nav-section a:hover {

    animation: filmFlicker .8s ease;
  }

  @keyframes filmFlicker {

    0% {
      opacity:1;
    }

    15% {
      opacity:.75;
    }

    25% {
      opacity:1;
    }

    40% {
      opacity:.85;
    }

    100% {
      opacity:1;
    }
  }
  .hero-logo-mark {
    position: absolute;
    left: 25%;
    top: 62%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: min(42vw, 22rem);
    height: min(42vw, 22rem);
    border-radius: 50%;
    background: #17130f;
    color: #f7e8c8;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    font-size: clamp(1.25rem, 3vw, 2rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  @media (max-width:1200px){

    hero-content {
      grid-template-columns:1fr .85fr;
    }

    hero-cta-title h1 {
      font-size:clamp(7rem,15vw,11rem);
    }

    hero-label {
      max-width:22rem;
    }

    hero-nav-section {
      justify-content: space-between;
    }
  }


  @media (max-width:850px){
    hero-section {
      display:block;
      min-height: 90svh;
      overflow:hidden;
    }

    hero-content {
      display:block;
    }

    hero-cta-column {
      min-height: 10svh;
      padding: 2rem 1.5rem;
      align-items: flex-start;
      text-align: left;
    }

    hero-cta-section {
      width: 100%;
      height: 50svh;
      justify-content: flex-start;
    }

    hero-label {
      font-size: .5em;
      font-weight: 700;
      letter-spacing: 0em;
      text-shadow: none;
      width: 75%;
    }

    hero-cta-title h1 {
      font-size: clamp(8rem, 24vw, 8rem);
      line-height:.82;
    }

    hero-nav-section a {
      font-size: 0.5em;
      font-weight: 800;
    }
    
    
    hero-img-column {
      position: relative;
      width: 100%;
      height: 50svh;
      overflow: hidden;
      margin-top: 2rem;
    }

    hero-img {
      display: block;
      width: 100%;
      height: 100%;
    }

    hero-img :global(img),
    hero-img img {
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center center;
      display:block;
    }
  }
</style>



