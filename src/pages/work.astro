---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/work.css';
import FloatingContact from '../components/FloatingContactBtn.astro';
import PageHeader from '../components/PageHeader.astro';

---

<html lang="en"> 
    <head>
		<BaseHead title="Work" description="Professional experience and education." />
    </head>
    <body>
        <Header />
            <main class="work-page">
                <PageHeader
				    title="Work"
				    kicker="Selected Works"
				    logline="Software developer with a background as a professional musician and visual artist. Brings creativity, discipline, and a highly collaborative spirit to every project."
			    />
                <div class="resume-page">

                    <!-- Bridgesphere -->
                    <div class="experience-grid">
                        <div class="left-col">
                            <div class="date-range">May 2025 – Jul 2026</div>
                            <div class="location">Toronto, ON </div>
                            <div class="work-type">REMOTE</div>
                        </div>
                        <div class="right-col">
                            <h3>Full Stack Developer - Royal Trillium Homes</h3>
                            <p class="role-desc"><strong>Stack:</strong> C# (.NET 8) • PostgreSQL • Entity Framework Core • React • TypeScript • Python (FastAPI) • MapBox • Azure • GitHub Actions</p>
                            <ul>
                                <li>
                                    Served as primary engineer for BridgeSphere, a production client platform supporting 300+ real estate professionals, owning architecture, implementation, deployment, and ongoing iteration across a small product team.
                                </li>
                                <li>
                                    Designed and delivered the application stack using C#, ASP.NET Core 8, React, TypeScript, PostgreSQL, and Azure, translating product requirements into technical specifications and production features.
                                </li>
                                <li>
                                    Owned the full software development lifecycle, from requirements and UI design through alpha/beta testing, feedback cycles, QA, deployment, and production support; managed delivery in Jira and delivered the contract approximately 3 weeks ahead of schedule.
                                </li>
                                <li>
                                    Built a React/TypeScript SPA with reusable custom components, role-based workflows, multi-step onboarding, profile-image uploads, Mapbox geospatial interfaces, and MUI/Recharts analytics dashboards.
                                </li>
                                <li>
                                    Built and maintained REST APIs with ASP.NET Core, applying dependency injection, layered architecture, and OpenAPI documentation to support maintainable backend services.
                                </li>
                                <li>
                                    Implemented role-based access control (RBAC) for clients, agents, and brokerages, enforcing role-specific workflows and data access at the API layer.
                                </li>

                                <li>
                                    Expanded automated backend coverage with xUnit, contributing to approximately 35% fewer regressions and 8 fewer hours of triage per sprint in later development cycles.
                                </li>
                                <li>
                                    Developed a FastAPI microservice incorporating embeddings for semantic profile matching, integrating Python-based functionality alongside the core .NET application.
                                </li>
                                <li>
                                    Optimized geospatial filtering with PostGIS, reducing a daily matching operation from approximately 20 seconds to 5 seconds.
                                </li>
                                <li>
                                    Built and maintained Azure infrastructure across Static Web Apps, App Service, PostgreSQL, Functions, and queues; implemented Docker-based CI/CD with GitHub Actions across Dev, QA, and Production environments.
                                </li>
                                <li>
                                    Collaborated directly with the product owner using Agile/Scrum practices, balancing technical implementation, stakeholder feedback, and roadmap priorities throughout delivery.
                                </li>
                            
                            </ul>
                        </div>
                    </div>


                    <div class="experience-grid">
                        <div class="left-col">
                            <div class="date-range">Jan 2024 – May 2025</div>
                            <div class="location">HALIFAX, NS</div>
                            <div class="work-type">ON-SITE</div>
                        </div>
                        <div class="right-col">
                            <h3>Frontend Developer – CARE Training App </h3>
                            <p class="role-desc"><strong>Key Achievement:</strong> Student of the Year (2024/2025) - awarded for technical contribution in delivering a quality healthcare training solution.</p>
                            <ul>
                                <li>
                                    Worked closely with 6 developers to ship Clinical Assessment Record Entry (CARE), a responsive, tablet-first full
                                    stack application automating and digitizing a pen-and-paper clinical assessment system.
                                </li>
                                <li>
                                    Designed the look in Figma, then built it in React. Sat with faculty at the bedside so the layout matched how they actually document.
                                </li>
                                <li>
                                    Shipped a React app used daily by 500+ nursing students and faculty. (Add TypeScript here only if the repo is TypeScript.)
                                </li>
                                <li>
                                    Worked with the team on the .NET API and a MySQL persistence path so classroom wifi drops did not wipe in-progress work.
                                </li>
                                <li>
                                    Traced live-class failures through the client and the API until the UI came back before grading stopped.
                                </li>
                                <li>
                                    Mentored 3 student developers on Git and reviews so a UI change did not take down a lab.
                                </li>
                                
                                
                            </ul>
                        </div>
                    </div>


                    <div class="experience-grid">
                        <div class="left-col">
                            <div class="date-range">May 2024 – Present</div>
                            <div class="location">REMOTE</div>
                            <div class="work-type">REMOTE</div>
                        </div>
                        <div class="right-col">
                            <h3>Web Developer/Designer</h3>
                            <p class="role-desc"><strong>Stack:</strong> JavaScript (React, Express) • MySQL • Prisma ORM • Figma • GitHub Projects</p>
                            <ul>
                                <li>Design, develop, and maintain WordPress websites for small businesses, combining PHP, JavaScript, CSS, Figma, and Adobe workflows from brand development through production deployment.</li>
                                <li>Manage Linux/Apache hosting, SSL configuration, backups, and site maintenance, maintaining measured service uptime of 97.8% across client infrastructure.</li>
                                <li>Integrate Square payments and booking workflows, connecting online reservations and in-store payment processes into a unified customer experience.</li>
                                <li>Redesigned a barbershop's e-commerce and booking experience, contributing to a 30% increase in monthly bookings and 15% increase in gross revenue within 30 days.</li>


                            </ul>
                        </div>
                    </div>

                    <!-- ===== EDUCATION ===== -->
                    <section class="section-divider">
                        <h2>Education</h2>
                    </section>

                    <!-- Berklee --> 
                    <div class="education-grid">
                        <div class="left-col">
                            <div class="date-range">2012 – 2016</div>
                            <div class="location">BOSTON, MA, USA</div>
                        </div>
                        <div class="right-col">
                            <h3>BA - Professional Music</h3>
                            <p class="role-desc">Berklee College of Music</p>
                            <ul class="honours-list">
                                <li>Dean's Honours List, Fall 2013</li>
                            </ul>
                        </div>
                    </div>

                    <!-- NSCC --> 
                    <div class="education-grid">
                        <div class="left-col">
                            <div class="date-range">2023 – 2025</div>
                            <div class="location">HALIFAX, NS</div>
                        </div>
                        <div class="right-col">
                            <h3>Diploma, IT Programming</h3>
                            <p class="role-desc">Nova Scotia Community College</p>
                            <ul class="honours-list">
                                <li>Honours List, Fall 2023</li>
                                <li>Honours List, 2024</li>
                                <li>
                                    <a href="https://www.nscc.ca/about/news/stories/2025/2024-co-op-and-wil-students-of-the-year.asp" target="_blank" rel="noopener rereferrer">
                                        WIL Student of The Year (2024-2025)
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- ===== CERTIFICATIONS ===== -->
                    <section class="section-divider">
                        <h2>Certifications</h2>
                    </section>

                    <div class="cert-grid">

                        <div class="cert-item">
                            <span class="cert-name">Unity Junior Programmer</span>
                            <span class="cert-issuer">Unity</span>
                            <span class="cert-year">2026</span>
                        </div>

                        <div class="cert-item">
                            <span class="cert-name">ITIL4 Foundation</span>
                            <span class="cert-issuer">PeopleCert</span>
                            <span class="cert-year">2026</span>
                        </div>

                        <div class="cert-item">
                            <span class="cert-name">Ubuntu Linux Professional Certificate</span>
                            <span class="cert-issuer">Canonical</span>
                            <span class="cert-year">2025</span>
                        </div>   

                        <div class="cert-item">
                            <span class="cert-name">Azure Fundamentals</span>
                            <span class="cert-issuer">Microsoft</span>
                            <span class="cert-year">2025</span>
                        </div>

                        <div class="cert-item">
                            <span class="cert-name">Docker Foundations</span>
                            <span class="cert-issuer">LinkedInLearning</span>
                            <span class="cert-year">2025</span>
                        </div>
                        
                    </div>
                
                </div>
                
            </main>
            
        <Footer />
    </body>
</html>




