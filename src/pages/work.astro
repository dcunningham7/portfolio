---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/work.css';
import FloatingContact from '../components/FloatingContactBtn.astro';
import PageHeader from '../components/PageHeader.astro';

---

<html lang="en"> 
    <head>
		<BaseHead title="Work" description="Professional experience and education." />
    </head>
    <body>
        <Header />
            <main class="work-page">
                <PageHeader
				    title="Work"
				    kicker="Selected Works"
				    logline="Software developer with a background as a professional musician and visual artist. Brings creativity, discipline, and a highly collaborative spirit to every project."
			    />
                <div class="resume-page">

                    <!-- Bridgesphere -->
                    <div class="experience-grid">
                        <div class="left-col">
                            <div class="date-range">May 2025 – Present</div>
                            <div class="location">Toronto, ON </div>
                            <div class="work-type">REMOTE</div>
                        </div>
                        <div class="right-col">
                            <h3>Full Stack Developer - Royal Trillium Homes</h3>
                            <p class="role-desc"><strong>Stack:</strong> C# (.NET 8) • PostgreSQL • Entity Framework Core • React • TypeScript • Python (FastAPI) • MapBox • Azure • GitHub Actions</p>
                            <ul>
                                <li>Led end-to-end delivery from concept to deployment, meeting with products owner to translate
                                    requirements into technical specifications, and managing the development roadmap. Maintained
                                    production uptime consistently since launch in August 2025.
                                </li>
                                <li>
                                    Built a production-ready React SPA with TypeScript serving 300+ real estate professionals, featuring
                                    customizable component libraries, multi-layered user profiles, interactive mapping via MapBox API, and a
                                    real-time analytics dashboard
                                </li>
                                <li>
                                    Engineered a multi-tier onboarding system supporting three distinct user roles – Client, Agent, and
                                    Brokerage – each with role-specific registration flows and permission-based matching logic. Used Form.io
                                    for validation on the frontend, with a PostgreSQL backend powered by Entity Framework Core to manage
                                    relational datasets
                                </li>
                                <li>
                                    Orchestrated cloud infrastructure and CI/CD pipeline using Azure App Service, Docker containers, and
                                    GitHub Actions, ensuring zero-downtime deployments and maintaining 100% production uptime since
                                    launch in August 2025.
                                </li>
                            </ul>
                        </div>
                    </div>


                    <div class="experience-grid">
                        <div class="left-col">
                            <div class="date-range">Jan 2025 – Jun 2025</div>
                            <div class="location">HALIFAX, NS</div>
                            <div class="work-type">ON-SITE</div>
                        </div>
                        <div class="right-col">
                            <h3>Frontend Developer – CARE Training App </h3>
                            <p class="role-desc"><strong>Key Achievement:</strong> Student of the Year (2024/2025) - awarded for technical contribution in delivering a quality healthcare training solution.</p>
                            <ul>
                                <li>Architected the frontend as an SPA with component-based patient profile builders and multi-step forms organized by type, keeping complex clinical data entry manageable for non-technical nursing staff.</li>
                                <li>Primary liaison between frontend and backend sub-teams, responsible for keeping API contracts aligned with user needs and documented hand-offs so nothing got lost in translation</li>
                                <li>Co-delivered the MVP pitch to healthcare administration, helping secure continued funding and a Fall 2026 production pilot in the nursing curriculum.</li>
                                
                            </ul>
                        </div>
                    </div>


                    <div class="experience-grid">
                        <div class="left-col">
                            <div class="date-range">May 2024 – Present</div>
                            <div class="location">REMOTE</div>
                            <div class="work-type">REMOTE</div>
                        </div>
                        <div class="right-col">
                            <h3>Web Developer/Designer</h3>
                            <p class="role-desc"><strong>Stack:</strong> JavaScript (React, Express) • MySQL • Prisma ORM • Figma • GitHub Projects</p>
                            <ul>
                                <li>Deliver complete WordPress websites with custom branding, theme customization, hosting, and backend support for small business clients.</li>
                                <li>Design logos, brand identities, and visual assets from concept to delivery, translating client vision into cohesive, professional brand packages</li>
                                <li>Achieved 30% increase in monthly booking and 15% increase in monthly revenue for a barbershop client by integrating WooCommerce/Square into website. Allowed the client to acquire enough revenue to lease a commercial space. </li>
                            </ul>
                        </div>
                    </div>

                    <!-- ===== EDUCATION ===== -->
                    <section class="section-divider">
                        <h2>Education</h2>
                    </section>

                    <!-- Berklee --> 
                    <div class="education-grid">
                        <div class="left-col">
                            <div class="date-range">2013 – 2016</div>
                            <div class="location">BOSTON, MA, USA</div>
                        </div>
                        <div class="right-col">
                            <h3>BA - Professional Music & Songwriting</h3>
                            <p class="role-desc">Berklee College of Music</p>
                            <ul class="honours-list">
                                <li>Dean's Honours List, Fall 2013</li>
                            </ul>
                        </div>
                    </div>

                    <!-- NSCC --> 
                    <div class="education-grid">
                        <div class="left-col">
                            <div class="date-range">2023 – 2025</div>
                            <div class="location">HALIFAX, NS</div>
                        </div>
                        <div class="right-col">
                            <h3>Associate of Science in Information Technology – Programming</h3>
                            <p class="role-desc">Nova Scotia Community College</p>
                            <ul class="honours-list">
                                <li>Honours List, Fall 2023</li>
                                <li>Honours List, 2024</li>
                                <li>Co-Op Student of The Year (2024-2025)</li>
                            </ul>
                        </div>
                    </div>

                    <!-- ===== CERTIFICATIONS ===== -->
                    <section class="section-divider">
                        <h2>Certifications</h2>
                    </section>

                    <div class="cert-grid">

                        <div class="cert-item">
                            <span class="cert-name">Unity Junior Programmer</span>
                            <span class="cert-issuer">Unity</span>
                            <span class="cert-year">2026</span>
                        </div>

                        <div class="cert-item">
                            <span class="cert-name">ITIL4 Foundation</span>
                            <span class="cert-issuer">PeopleCert</span>
                            <span class="cert-year">2026</span>
                        </div>

                        <div class="cert-item">
                            <span class="cert-name">Ubuntu Linux Professional Certificate</span>
                            <span class="cert-issuer">Canonical</span>
                            <span class="cert-year">2025</span>
                        </div>   

                        <div class="cert-item">
                            <span class="cert-name">Azure Fundamentals</span>
                            <span class="cert-issuer">Microsoft</span>
                            <span class="cert-year">2024</span>
                        </div>

                        <div class="cert-item">
                            <span class="cert-name">Docker Foundations</span>
                            <span class="cert-issuer">LinkedInLearning</span>
                            <span class="cert-year">2025</span>
                        </div>
                        
                    </div>
                
                </div>
                
            </main>
            
        <Footer />
    </body>
</html>




