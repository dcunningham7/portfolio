---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import '../../styles/reel-title.css';

const projects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => {
	const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
	const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
	if (orderA !== orderB) return orderA - orderB;
	return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

let featuredSeen = 0;
const posters = projects.map((project, index) => ({
	project,
	index,
	flip: project.data.featured ? featuredSeen++ % 2 === 1 : false,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Projects" description="Selected case studies and builds." />
	</head>
	<body>
		<Header />
		<main>
			<header class="reel-title">
				<div class="reel-title-copy">
					<p class="kicker">Selected works</p>
					<h1>Projects</h1>
				</div>
				<p class="logline">
					Project showcases, case studies, builds, & experiments in software development.
				</p>
			</header>

			<section class="reel" aria-label="Project list">
				{
					posters.map(({ project, index, flip }) => (
						<a
							class:list={['poster', { featured: project.data.featured, flip }]}
							href={`/projects/${project.id}/`}
						>
							{project.data.heroImage && (
								<div class="poster-still">
									<Image
										src={project.data.heroImage}
										alt=""
										widths={[480, 800, 1200]}
										sizes="(max-width: 720px) 100vw, 50vw"
									/>
								</div>
							)}
							<div class="poster-copy">
								<span class="poster-number">{String(index + 1).padStart(2, '0')}</span>
								{project.data.featured && <p class="badge">Featured</p>}
								<h2>{project.data.title}</h2>
								<p class="summary">{project.data.summary}</p>
								<p class="meta">
									<span>{project.data.role}</span>
									<span aria-hidden="true">·</span>
									<span>{project.data.stack.slice(0, 4).join(' / ')}</span>
								</p>
							</div>
						</a>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background: #f4b51b;
		color: #17130f;
	}

	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0 0 5rem;
	}

	.badge {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.reel {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		border-top: 2px solid #17130f;
	}

	.poster {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr;
		min-height: 28rem;
		overflow: hidden;
		border-right: 1px solid #17130f;
		border-bottom: 2px solid #17130f;
		background: #17130f;
		color: inherit;
		text-decoration: none;
	}

	.poster:nth-child(2n) {
		border-right: 0;
	}

	.poster.featured {
		grid-column: 1 / -1;
		grid-template-columns: 1.2fr 1fr;
		grid-template-rows: 1fr;
		min-height: min(40vh, 440px);
	}

	.poster.featured + .poster.featured {
		margin-top: 1.25rem;
	}

	.poster.featured.flip {
		grid-template-columns: 1fr 1.2fr;
	}

	.poster.featured.flip .poster-copy {
		order: -1;
	}

	.poster-number {
		position: absolute;
		z-index: 2;
		top: 1.5rem;
		left: clamp(1rem, 3vw, 2rem);
		padding: 0.25rem 0.45rem;
		background: #f4b51b;
		color: #17130f;
		font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
		font-size: 1.1rem;
		letter-spacing: 0.06em;
	}

	.poster-still {
		min-height: 16rem;
		overflow: hidden;
		background: #0d0b09;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
	}

	.poster.featured .poster-still {
		min-height: 100%;
	}

	.poster-still :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		filter: contrast(1.05) saturate(0.9);
		transition: transform 0.45s ease, filter 0.45s ease;
		flex-shrink: 0;
	}

	.poster:hover .poster-still :global(img) {
		transform: scale(1.04);
		filter: contrast(1.08) saturate(1);
	}

	.poster-copy {
		position: relative;
		display: grid;
		align-content: center;
		gap: 0.65rem;
		padding: 1.5rem clamp(1rem, 3vw, 2rem) 1.75rem;
		background: #f7e8c8;
	}

	.badge {
		width: fit-content;
		padding: 0.2rem 0.45rem;
		background: #c8171d;
		color: #f7e8c8;
	}

	.poster-copy h2 {
		margin: 0;
		color: #c8171d;
		font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
		font-size: clamp(2.6rem, 7vw, 5.5rem);
		line-height: 0.9;
		letter-spacing: 0.01em;
		text-transform: uppercase;
	}

	.summary {
		margin: 0;
		max-width: 36rem;
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.55rem;
		margin: 0.25rem 0 0;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #5a4a3a;
	}

	@media (max-width: 1024px) {
		.reel {
			grid-template-columns: repeat(2, 1fr);
			gap: 0;
		}
		
		.poster.featured {
			grid-template-columns: 1.1fr 1fr;
			min-height: min(35vh, 380px);
		}
		
		.poster.featured.flip {
			grid-template-columns: 1fr 1.1fr;
		}
	}

	@media (max-width: 820px) {
		.reel {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 0 1rem;
			border-top: none;
		}

		.poster {
			display: flex;
			flex-direction: column;
			min-height: 0;
			border: 2px solid #17130f;
			border-radius: 4px;
			margin: 0;
			box-shadow: 0 8px 24px rgba(0,0,0,0.15);
			background: #17130f;
			max-width: 100%;
		}

		.poster:nth-child(2n) {
			border-right: 2px solid #17130f;
		}

		.poster.featured {
			display: flex;
			flex-direction: column;
			grid-column: auto;
			grid-template-columns: 1fr;
			grid-template-rows: auto;
			min-height: 0;
			max-width: 100%;
		}

		.poster.featured + .poster.featured {
			margin-top: 0;
		}

		.poster.featured.flip {
			flex-direction: column;
			grid-template-columns: 1fr;
		}

		.poster.featured.flip .poster-copy {
			order: 0;
		}

		.poster-still {
			width: 100%;
			min-height: 200px;
			height: auto;
			aspect-ratio: 4/3;
			overflow: hidden;
			flex-shrink: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			background: #0d0b09;
		}

		.poster.featured .poster-still {
			width: 100%;
			min-height: 200px;
			height: auto;
			aspect-ratio: 4/3;
			flex-shrink: 0;
		}

		.poster-still :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center center;
			display: block;
		}

		.poster-copy {
			padding: 2rem 1.5rem;
			gap: 0.8rem;
			flex: 1;
			width: 100%;
		}

		.poster-number {
			top: 1rem;
			left: 1rem;
			font-size: 0.95rem;
			padding: 0.25rem 0.5rem;
		}

		.badge {
			font-size: 0.7rem;
			letter-spacing: 0.15em;
		}

		.poster-copy h2 {
			font-size: clamp(2.8rem, 10vw, 4.5rem);
			line-height: 0.9;
			letter-spacing: -0.02em;
		}

		.summary {
			font-size: 1rem;
			line-height: 1.5;
			max-width: none;
		}

		.meta {
			font-size: 0.78rem;
			gap: 0.35rem 0.5rem;
		}

		.reel-title {
			margin-top: 0;
			padding-top: clamp(2rem, 6vh, 4rem);
			padding-bottom: 3rem;
			padding-left: 1rem;
			padding-right: 1rem;
			text-align: left;
		}

		.reel-title h1 {
			font-size: clamp(5rem, 20vw, 8rem);
			line-height: 0.82;
			letter-spacing: -0.05em;
			margin: 0;
		}

		.logline {
			font-size: 1.1rem;
			max-width: 28rem;
		}
	}

	@media (max-width: 480px) {
		.reel {
			gap: 1.25rem;
			padding: 0 0.75rem;
		}

		.poster {
			border-width: 2px;
			border-radius: 4px;
		}

		.poster-still {
			width: 100%;
			min-height: 180px;
			height: auto;
			aspect-ratio: 4/3;
			overflow: hidden;
			flex-shrink: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			background: #0d0b09;
		}

		.poster.featured .poster-still {
			width: 100%;
			min-height: 180px;
			height: auto;
			aspect-ratio: 4/3;
			flex-shrink: 0;
		}

		.poster-still :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center center;
			display: block;
		}

		.poster-copy {
			padding: 1.5rem 1.25rem;
			gap: 0.6rem;
		}

		.poster-number {
			top: 0.75rem;
			left: 0.75rem;
			font-size: 0.85rem;
			padding: 0.2rem 0.4rem;
		}

		.poster-copy h2 {
			font-size: clamp(2.2rem, 12vw, 3.5rem);
			line-height: 0.85;
		}

		.summary {
			font-size: 0.9rem;
			line-height: 1.5;
		}

		.meta {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.2rem;
			font-size: 0.7rem;
		}

		.meta span[aria-hidden] {
			display: none;
		}

		.badge {
			font-size: 0.65rem;
			padding: 0.15rem 0.4rem;
		}

		.reel-title {
			padding: 1.5rem 0.75rem 2.5rem;
		}

		.reel-title h1 {
			font-size: clamp(4rem, 18vw, 6rem);
		}

		.logline {
			font-size: 0.95rem;
			max-width: 100%;
		}
	}

	@media (max-width: 375px) {
		.reel {
			gap: 1rem;
			padding: 0 0.5rem;
		}

		.poster-still {
			width: 100%;
			min-height: 150px;
			height: auto;
			aspect-ratio: 4/3;
			overflow: hidden;
			flex-shrink: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			background: #0d0b09;
		}

		.poster.featured .poster-still {
			width: 100%;
			min-height: 150px;
			height: auto;
			aspect-ratio: 4/3;
			flex-shrink: 0;
		}

		.poster-still :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center center;
			display: block;
		}

		.poster-copy {
			padding: 1.25rem 1rem;
			gap: 0.5rem;
		}

		.poster-copy h2 {
			font-size: clamp(1.8rem, 10vw, 2.8rem);
		}

		.summary {
			font-size: 0.85rem;
		}

		.poster-number {
			font-size: 0.75rem;
			top: 0.5rem;
			left: 0.5rem;
			padding: 0.15rem 0.35rem;
		}

		.reel-title h1 {
			font-size: clamp(3.5rem, 16vw, 5rem);
		}

		.logline {
			font-size: 0.85rem;
		}
	}

	@media (hover: none) {
		.poster {
			transition: transform 0.18s ease;
		}

		.poster:active {
			transform: scale(0.985);
		}

		.poster:hover .poster-still :global(img) {
			transform: scale(1);
			filter: contrast(1.05) saturate(0.9);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.poster,
		.poster-still :global(img) {
			transition: none;
		}

		.poster:hover .poster-still :global(img),
		.poster:active {
			transform: none;
		}
	}
</style>
