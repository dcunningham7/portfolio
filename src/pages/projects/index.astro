---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import '../../styles/reel-title.css';

const projects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => {
	const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
	const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
	if (orderA !== orderB) return orderA - orderB;
	return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

let featuredSeen = 0;
const posters = projects.map((project, index) => ({
	project,
	index,
	flip: project.data.featured ? featuredSeen++ % 2 === 1 : false,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Projects" description="Selected case studies and builds." />
	</head>
	<body>
		<Header />
		<main>
			<header class="reel-title">
				<div class="reel-title-copy">
					<p class="kicker">Selected works</p>
					<h1>Projects</h1>
				</div>
				<p class="logline">
					Project showcases, case studies, builds, & experiments in software development.
				</p>
			</header>

			<section class="reel" aria-label="Project list">
				{
					posters.map(({ project, index, flip }) => (
						<a
							class:list={['poster', { featured: project.data.featured, flip }]}
							href={`/projects/${project.id}/`}
						>
							{project.data.heroImage && (
								<div class="poster-still">
									<Image
										src={project.data.heroImage}
										alt=""
										widths={[480, 800, 1200]}
										sizes="(max-width: 720px) 100vw, 50vw"
									/>
								</div>
							)}
							<div class="poster-copy">
								<span class="poster-number">{String(index + 1).padStart(2, '0')}</span>
								{project.data.featured && <p class="badge">Featured</p>}
								<h2>{project.data.title}</h2>
								<p class="summary">{project.data.summary}</p>
								<p class="meta">
									<span>{project.data.role}</span>
									<span aria-hidden="true">·</span>
									<span>{project.data.stack.slice(0, 4).join(' / ')}</span>
								</p>
							</div>
						</a>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background: #f4b51b;
		color: #17130f;
	}

	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0 0 5rem;
	}

	.badge {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.reel {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		border-top: 2px solid #17130f;
	}

	.poster {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr;
		min-height: 28rem;
		overflow: hidden;
		border-right: 1px solid #17130f;
		border-bottom: 2px solid #17130f;
		background: #17130f;
		color: inherit;
		text-decoration: none;
	}

	.poster:nth-child(2n) {
		border-right: 0;
	}

	.poster.featured {
		grid-column: 1 / -1;
		grid-template-columns: 1.2fr 1fr;
		grid-template-rows: 1fr;
		min-height: min(40vh, 440px);
	}

	.poster.featured + .poster.featured {
		margin-top: 1.25rem;
	}

	.poster.featured.flip {
		grid-template-columns: 1fr 1.2fr;
	}

	.poster.featured.flip .poster-copy {
		order: -1;
	}

	.poster-number {
		position: absolute;
		z-index: 2;
		top: 1.5rem;
		left: clamp(1rem, 3vw, 2rem);
		padding: 0.25rem 0.45rem;
		background: #f4b51b;
		color: #17130f;
		font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
		font-size: 1.1rem;
		letter-spacing: 0.06em;
	}

	.poster-still {
		min-height: 16rem;
		overflow: hidden;
		background: #0d0b09;
	}

	.poster.featured .poster-still {
		min-height: 100%;
	}

	.poster-still :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: contrast(1.05) saturate(0.9);
		transition: transform 0.45s ease, filter 0.45s ease;
	}

	.poster:hover .poster-still :global(img) {
		transform: scale(1.04);
		filter: contrast(1.08) saturate(1);
	}

	.poster-copy {
		position: relative;
		display: grid;
		align-content: center;
		gap: 0.65rem;
		padding: 1.5rem clamp(1rem, 3vw, 2rem) 1.75rem;
		background: #f7e8c8;
	}

	.badge {
		width: fit-content;
		padding: 0.2rem 0.45rem;
		background: #c8171d;
		color: #f7e8c8;
	}

	.poster-copy h2 {
		margin: 0;
		color: #c8171d;
		font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
		font-size: clamp(2.6rem, 7vw, 5.5rem);
		line-height: 0.9;
		letter-spacing: 0.01em;
		text-transform: uppercase;
	}

	.summary {
		margin: 0;
		max-width: 36rem;
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.55rem;
		margin: 0.25rem 0 0;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #5a4a3a;
	}

	@media (max-width: 800px) {
		.reel {
			grid-template-columns: 1fr;
		}

		.poster,
		.poster.featured {
			grid-column: auto;
			grid-template-columns: 1fr;
			min-height: 0;
		}

		.poster {
			border-right: 0;
		}

		.poster.featured.flip {
			grid-template-columns: 1fr;
		}

		.poster.featured.flip .poster-copy {
			order: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.poster-still :global(img) {
			transition: none;
		}

		.poster:hover .poster-still :global(img) {
			transform: none;
		}
	}
</style>
